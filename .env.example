# Local SQLite:
DATABASE_URL="file:./dev.db"
# Production Turso (Vercel):
# DATABASE_URL="libsql://YOUR-DB-ORG.turso.io"
# TURSO_AUTH_TOKEN=""
TURSO_AUTH_TOKEN=
STRIPE_SECRET_KEY=
# Must match live endpoint https://skillpulse-ai-ten.vercel.app/api/stripe/webhook (Dashboard → Webhooks → Signing secret)
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Optional Groq (preferred) or generic OpenAI-compatible key for richer course JSON.
# Missing/timeout/parse failure → free template-heuristics fallback (catalog still grows).
GROQ_API_KEY=
AI_API_KEY=
# Optional Groq model override (default llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant
# Required in production for /api/jobs/tick (also set same value as GitHub Actions secret)
CRON_SECRET=
# Local default OK; production MUST be https://skillpulse-ai-ten.vercel.app (never localhost — breaks phone after Stripe)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Max new SkillGaps per UTC day from free research tick (default 10)
MAX_RESEARCH_GAPS_PER_DAY=10
# Optional social posting (empty = drafts only for Reddit/X/LinkedIn)
REDDIT_CLIENT_ID=
TWITTER_API_KEY=
LINKEDIN_ACCESS_TOKEN=
# Bluesky auto-post (one post per PromoJob when set; kill switch blocks)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Optional: set false to keep drafts but skip outbound Bluesky posts
SOCIAL_POSTING_ENABLED=
# Comma/semicolon-separated; trim+case-insensitive; no wrapping quotes on Vercel.
# Matching buyers pay $0.01; everyone else pays full price. Redeploy after changing.
OWNER_EMAILS=mcdables@gmail.com
